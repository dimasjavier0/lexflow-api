generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningStatus {
  WANT_TO_LEARN
  NOT_INTERESTED
  LEARNED
}

model User {
  /// Identificador UUID entregado por Supabase Auth.
  id        String             @id @db.Uuid
  email     String             @unique
  role      UserRole           @default(USER)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  progress  UserWordProgress[]
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  words       CollectionWord[]

  @@index([isPublished])
}

model Word {
  id            String             @id @default(uuid()) @db.Uuid
  term          String             @unique
  translationEs String
  level         CefrLevel          @default(A1)
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  collections   CollectionWord[]
  images        Image[]
  audios        Audio[]
  videos        Video[]
  progress      UserWordProgress[]

  @@index([level, isPublished])
}

model CollectionWord {
  collectionId String     @db.Uuid
  wordId       String     @db.Uuid
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  word         Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([collectionId, wordId])
  @@index([collectionId, position])
  @@index([wordId])
}

model Image {
  id          String   @id @default(uuid()) @db.Uuid
  wordId      String   @db.Uuid
  url         String
  source      String
  provider    String?
  license     String?
  attribution String?
  metadata    Json?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

model Audio {
  id        String   @id @default(uuid()) @db.Uuid
  wordId    String   @db.Uuid
  url       String
  provider  String?
  voice     String?
  accent    String?
  metadata  Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

model Video {
  id          String   @id @default(uuid()) @db.Uuid
  wordId      String   @db.Uuid
  url         String
  source      String
  provider    String?
  license     String?
  attribution String?
  metadata    Json?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

model UserWordProgress {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  wordId    String         @db.Uuid
  status    LearningStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word           @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([wordId])
}
