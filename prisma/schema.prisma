generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  DETERMINER
  INTERJECTION
  PHRASE
}

enum WordRelationshipType {
  SYNONYM
  ANTONYM
  DERIVED
  COLLOCATION
  PHRASAL
  RELATED
}

/// Etapa de una palabra dentro del repaso espaciado.
enum SrsStage {
  NEW
  LEARNING
  MASTERED
}

enum LearningStatus {
  WANT_TO_LEARN
  NOT_INTERESTED
  LEARNED
}

model User {
  /// Identificador UUID entregado por Supabase Auth.
  id        String             @id @db.Uuid
  email     String             @unique
  role      UserRole           @default(USER)
  name      String?
  avatarUrl String?
  /// Gamificación básica: los puntos solo se ganan con repasos acertados.
  pointsTotal    Int       @default(0)
  streakCurrent  Int       @default(0)
  streakBest     Int       @default(0)
  /// Último día (UTC) con al menos un repaso; base del cálculo de la racha.
  lastActivityOn DateTime? @db.Date
  /// Id de Facebook propio de esta app (app-scoped); null si nunca entró con Facebook.
  facebookId     String?   @unique
  /// Si en su último inicio de sesión con Facebook concedió el permiso `user_friends`.
  facebookFriendsGranted Boolean @default(false)
  friends        Friendship[] @relation("UserFriends")
  friendOf       Friendship[] @relation("FriendOfUser")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  progress  UserWordProgress[]
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  words       CollectionWord[]

  @@index([isPublished])
}

model Word {
  id            String             @id @default(uuid()) @db.Uuid
  term          String             @unique
  translationEs String
  level         CefrLevel          @default(A1)
  partOfSpeech  PartOfSpeech?
  /// Posición en un corpus de frecuencia (1 = la palabra más usada).
  frequencyRank Int?
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  collections   CollectionWord[]
  images        Image[]
  audios        Audio[]
  videos        Video[]
  sentences     ExampleSentence[]
  relationsFrom WordRelationship[] @relation("RelationSource")
  relationsTo   WordRelationship[] @relation("RelationTarget")
  progress      UserWordProgress[]

  @@index([level, isPublished])
}

model CollectionWord {
  collectionId String     @db.Uuid
  wordId       String     @db.Uuid
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  word         Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([collectionId, wordId])
  @@index([collectionId, position])
  @@index([wordId])
}

model Image {
  id          String   @id @default(uuid()) @db.Uuid
  wordId      String   @db.Uuid
  url         String
  source      String
  provider    String?
  license     String?
  attribution String?
  metadata    Json?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

model Audio {
  id        String   @id @default(uuid()) @db.Uuid
  wordId    String   @db.Uuid
  url       String
  provider  String?
  voice     String?
  accent    String?
  metadata  Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

model Video {
  id          String   @id @default(uuid()) @db.Uuid
  wordId      String   @db.Uuid
  url         String
  source      String
  provider    String?
  license     String?
  attribution String?
  metadata    Json?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

model ExampleSentence {
  id            String   @id @default(uuid()) @db.Uuid
  wordId        String   @db.Uuid
  text          String
  translationEs String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId, position])
}

/// Relación dirigida entre dos palabras (source → target).
model WordRelationship {
  id           String               @id @default(uuid()) @db.Uuid
  sourceWordId String               @db.Uuid
  targetWordId String               @db.Uuid
  type         WordRelationshipType
  createdAt    DateTime             @default(now())
  source       Word                 @relation("RelationSource", fields: [sourceWordId], references: [id], onDelete: Cascade)
  target       Word                 @relation("RelationTarget", fields: [targetWordId], references: [id], onDelete: Cascade)

  @@unique([sourceWordId, targetWordId, type])
  @@index([targetWordId])
}

model UserWordProgress {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  wordId    String         @db.Uuid
  status    LearningStatus
  /// Estado SM-2. Solo avanza con los repasos de las palabras WANT_TO_LEARN.
  stage          SrsStage  @default(NEW)
  repetitions    Int       @default(0)
  intervalDays   Int       @default(0)
  easeFactor     Float     @default(2.5)
  lastReviewedAt DateTime?
  /// null = pendiente desde ya (todavía no se ha repasado nunca).
  nextReviewAt   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word           @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@index([wordId])
}

/// Amistad de Facebook entre dos usuarios de LexFlow. Se guarda en los dos sentidos,
/// así «mis amigos» es una consulta por `userId`.
model Friendship {
  userId    String   @db.Uuid
  friendId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
}
