# apps/api
DATABASE_URL="postgresql://lexflow:lexflow@localhost:5433/lexflow?schema=public"
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""
API_PORT="3000"
# Orígenes web permitidos, separados por comas. Vacío = cualquiera (solo desarrollo local).
CORS_ORIGINS=""
PIXABAY_API_KEY=""
# Opcionales: fuentes extra del buscador de videos. Ambas claves son gratuitas.
PEXELS_API_KEY=""
YOUTUBE_API_KEY=""
# Opcional: identifica la app ante Wikimedia (sonidos y videos), p. ej. "LexFlow/0.1 (tu-correo-o-web)".
WIKIMEDIA_USER_AGENT=""
PIPER_PATH="C:/Users/NAMEUSER/.pyenv/pyenv-win/versions/3.12.4/Scripts/piper.exe"
PIPER_VOICE_MODEL_US="apps/api/models/piper/en_US-amy-medium.onnx"
PIPER_VOICE_MODEL_UK="apps/api/models/piper/en_GB-alan-medium.onnx"

# apps/web (Vite only exposes variables prefixed with VITE_)
VITE_API_URL="http://localhost:3000"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Opcional: ID de un reproductor propio de Dailymotion (Dailymotion Studio → Players). Sin él, sus videos se abren en dailymotion.com.
VITE_DAILYMOTION_PLAYER_ID=""
