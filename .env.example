DATABASE_URL="postgresql://lexflow:lexflow@localhost:5433/lexflow?schema=public"
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""
# Clave service_role de Supabase (Project Settings → API). Es secreta: solo en el servidor, nunca en la web.
# La usa DELETE /me para borrar la cuenta de inicio de sesión; sin ella, borrar la cuenta responde 503.
SUPABASE_SERVICE_ROLE_KEY=""
API_PORT="3000"
# Orígenes web permitidos, separados por comas. Vacío = cualquiera (solo desarrollo local); "none" = ninguno
# (en producción la web y la API comparten dominio).
CORS_ORIGINS=""
PIXABAY_API_KEY=""
# Clave secreta de la app de Facebook, la misma que en Supabase (Authentication → Providers → Facebook).
# La API firma con ella las llamadas a la Graph API que leen la lista de amigos.
FACEBOOK_APP_SECRET=""
# Opcionales: fuentes extra del buscador de videos. Ambas claves son gratuitas.
PEXELS_API_KEY=""
YOUTUBE_API_KEY=""
# Opcional: identifica la app ante Wikimedia (sonidos y videos), p. ej. "LexFlow/1.0 (tu-correo-o-web)".
WIKIMEDIA_USER_AGENT=""
# Pronunciación con Piper TTS. Las rutas relativas parten de la raíz de este repositorio.
PIPER_PATH="piper"
PIPER_VOICE_MODEL_US="models/piper/en_US-amy-medium.onnx"
PIPER_VOICE_MODEL_UK="models/piper/en_GB-alan-medium.onnx"
# Solo en producción (AWS). Los define la infraestructura (infra/); en local se dejan sin poner.
# MEDIA_BUCKET=""          # Bucket S3 de imágenes y audios; sin él se usan uploads/ y la API los sirve.
# PUBLIC_BASE_URL=""       # Opcional: origen público que sirve /uploads. Si falta, se usa el que CloudFront envía en x-public-origin.
# TRUST_PROXY_HOPS=""      # Proxies delante de la API (CloudFront y la Function URL: 2), para ver la IP real.
# ORIGIN_VERIFY_SECRET=""  # Secreto que CloudFront envía en x-origin-verify; sin él la API acepta cualquier origen.
# SSM_SECRETS_PATH=""      # Ruta de SSM Parameter Store con los secretos (p. ej. /lexflow/prod/).
# DATABASE_POOL_MAX=""     # Conexiones máximas a PostgreSQL por instancia (10 por defecto; 2 en Lambda).
